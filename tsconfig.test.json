{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "bench/**/*.ts"],
  // The consumer resolves the package by name, which only an install provides.
  "exclude": ["node_modules", "dist", "tests/consumer"]
}
