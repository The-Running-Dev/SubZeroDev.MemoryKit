{
  "name": "subzerodev-memorykit",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, inspectable memory for applications and AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./history-git": {
      "types": "./dist/history-git/index.d.ts",
      "default": "./dist/history-git/index.js"
    }
  },
  "bin": {
    "memorykit": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "eslint . --max-warnings 0",
    "check:package": "node scripts/check-package.ts",
    "bench": "node --no-warnings bench/baseline.ts",
    "eval": "node --no-warnings eval/retrieval/run.ts",
    "start": "node dist/cli/main.js",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "check:release": "node scripts/verify-release.ts"
  },
  "keywords": [
    "memory",
    "sqlite",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Running-Dev/SubZeroDev.MemoryKit.git"
  },
  "homepage": "https://github.com/The-Running-Dev/SubZeroDev.MemoryKit#readme",
  "bugs": {
    "url": "https://github.com/The-Running-Dev/SubZeroDev.MemoryKit/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
